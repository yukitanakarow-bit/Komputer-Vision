@dataclass
class SatelliteTile:
	image: np.ndarray
	lat: float
	lon: float
	timestamp: datetime
	name: str
	source: str = "unknown"


def bgr_to_photoimage(frame: np.ndarray) -> tk.PhotoImage:
	rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
	h, w = rgb.shape[:2]
	ppm_header = f"P6 {w} {h} 255 ".encode("ascii")
	return tk.PhotoImage(data=ppm_header + rgb.tobytes(), format="PPM")


def parse_metadata_from_name(path: Path, index: int) -> Tuple[float, float, datetime]:
	stem = path.stem
	numbers = re.findall(r"-?\d+(?:\.\d+)?", stem)

	if len(numbers) >= 3:
		lat = float(numbers[0])
		lon = float(numbers[1])
		ts_raw = numbers[2]
		try:
			if len(ts_raw) >= 10:
				timestamp = datetime.fromtimestamp(float(ts_raw))
			else:
				timestamp = datetime.fromtimestamp(index)
		except ValueError:
			timestamp = datetime.fromtimestamp(index)
		return lat, lon, timestamp

	lat = float(index)
	lon = float(index)
	timestamp = datetime.fromtimestamp(index)
	return lat, lon, timestamp


def load_tiles_from_folder(folder: Path, tile_size: int) -> List[SatelliteTile]:
	tiles: List[SatelliteTile] = []
	image_paths = sorted(
		[p for p in folder.iterdir() if p.suffix.lower() in {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}]
	)

	for index, path in enumerate(image_paths):
		img = cv2.imread(str(path), cv2.IMREAD_COLOR)
		if img is None:
			continue
		img = cv2.resize(img, (tile_size, tile_size), interpolation=cv2.INTER_AREA)
		lat, lon, timestamp = parse_metadata_from_name(path, index)
		tiles.append(SatelliteTile(img, lat, lon, timestamp, path.name, source="folder"))

	return tiles


def latlon_to_tilexy(lat: float, lon: float, zoom: int) -> Tuple[int, int]:
	lat = float(np.clip(lat, -85.05112878, 85.05112878))
	n = 2.0 ** zoom
	lat_rad = np.deg2rad(lat)
	x = int((lon + 180.0) / 360.0 * n)
	y = int((1.0 - np.log(np.tan(lat_rad) + 1.0 / np.cos(lat_rad)) / np.pi) / 2.0 * n)
	return x, y


def tilexy_to_latlon_center(x: int, y: int, zoom: int) -> Tuple[float, float]:
	n = 2.0 ** zoom
	lon = (x + 0.5) / n * 360.0 - 180.0
	lat_rad = np.arctan(np.sinh(np.pi * (1.0 - 2.0 * (y + 0.5) / n)))
	lat = float(np.rad2deg(lat_rad))
	return lat, lon


def download_osm_tiles(lat_min: float, lat_max: float, lon_min: float, lon_max: float, zoom: int, tile_size: int) -> List[SatelliteTile]:
	# OpenStreetMap XYZ tile download for educational/demo usage.
	x0, y0 = latlon_to_tilexy(lat_max, lon_min, zoom)
	x1, y1 = latlon_to_tilexy(lat_min, lon_max, zoom)
	x_min, x_max = min(x0, x1), max(x0, x1)
	y_min, y_max = min(y0, y1), max(y0, y1)

	tiles: List[SatelliteTile] = []
	base_time = datetime.now().replace(microsecond=0)
	counter = 0

	for y in range(y_min, y_max + 1):
		for x in range(x_min, x_max + 1):
			url = f"https://tile.openstreetmap.org/{zoom}/{x}/{y}.png"
			try:
				req = Request(url, headers={"User-Agent": "Satellite-Compositor-Lab/1.0"})
				with urlopen(req, timeout=8) as resp:
					data = np.asarray(bytearray(resp.read()), dtype=np.uint8)
				img = cv2.imdecode(data, cv2.IMREAD_COLOR)
			except URLError:
				continue
			except TimeoutError:
				continue

			if img is None:
				continue

			if img.shape[0] != tile_size or img.shape[1] != tile_size:
				img = cv2.resize(img, (tile_size, tile_size), interpolation=cv2.INTER_AREA)

			lat, lon = tilexy_to_latlon_center(x, y, zoom)
			timestamp = datetime.fromtimestamp(base_time.timestamp() + counter * 120)
			counter += 1
			tiles.append(SatelliteTile(img, lat, lon, timestamp, f"osm_z{zoom}_{x}_{y}.png", source="download"))

	return tiles


def generate_synthetic_tiles(tile_count: int, tile_size: int) -> List[SatelliteTile]:
	rng = np.random.default_rng(42)
	tiles: List[SatelliteTile] = []
	base_time = datetime.now()

	for index in range(tile_count):
		lat = 10.0 + (index // 3) * 0.08
		lon = 100.0 + (index % 3) * 0.08
		timestamp = datetime.fromtimestamp(base_time.replace(microsecond=0).timestamp() + index * 180)

		img = np.zeros((tile_size, tile_size, 3), dtype=np.uint8)
		base_color = np.array([
			60 + index * 12,
			90 + index * 8,
			120 + index * 5,
		], dtype=np.int32)
		img[:] = np.clip(base_color, 0, 255).astype(np.uint8)

		for _ in range(9):
			x1 = int(rng.integers(0, tile_size - 40))
			y1 = int(rng.integers(0, tile_size - 40))
			x2 = min(tile_size - 1, x1 + int(rng.integers(20, 90)))
			y2 = min(tile_size - 1, y1 + int(rng.integers(20, 90)))
			color = tuple(int(c) for c in rng.integers(40, 230, size=3))
			cv2.rectangle(img, (x1, y1), (x2, y2), color, -1)

		for _ in range(30):
			center = (int(rng.integers(0, tile_size)), int(rng.integers(0, tile_size)))
			radius = int(rng.integers(4, 18))
			color = tuple(int(c) for c in rng.integers(80, 255, size=3))
			cv2.circle(img, center, radius, color, -1)

		# Simulate temporal exposure drift and partial cloud patches.
		exposure_gain = 0.75 + 0.5 * (index / max(1, tile_count - 1))
		img = np.clip(img.astype(np.float32) * exposure_gain, 0, 255).astype(np.uint8)
		if index % 3 == 1:
			for _ in range(3):
				cx = int(rng.integers(tile_size // 4, tile_size - tile_size // 4))
				cy = int(rng.integers(tile_size // 4, tile_size - tile_size // 4))
				r = int(rng.integers(tile_size // 8, tile_size // 4))
				cv2.circle(img, (cx, cy), r, (245, 245, 245), -1)

		tiles.append(SatelliteTile(img, lat, lon, timestamp, f"synthetic_{index:02d}.png", source="synthetic"))

	return tiles


def cloud_mask(image: np.ndarray, white_threshold: int, saturation_threshold: int) -> np.ndarray:
	hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
	h, s, v = cv2.split(hsv)
	mask = ((v >= white_threshold) & (s <= saturation_threshold)).astype(np.uint8) * 255
	kernel = np.ones((5, 5), np.uint8)
	mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
	mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
	return mask


def exposure_compensation(tile: np.ndarray, reference_mean: Optional[np.ndarray], strength: float) -> np.ndarray:
	if reference_mean is None:
		return tile

	current_mean = tile.reshape(-1, 3).mean(axis=0) + 1e-6
	gain = np.clip(reference_mean / current_mean, 0.75, 1.35)
	gain = 1.0 + (gain - 1.0) * strength
	adjusted = np.clip(tile.astype(np.float32) * gain, 0, 255).astype(np.uint8)
	return adjusted


def feather_blend(base: np.ndarray, overlay: np.ndarray, mask: np.ndarray, feather_px: int) -> np.ndarray:
	if np.count_nonzero(mask) == 0:
		return base

	mask_f = (mask.astype(np.float32) / 255.0)
	if feather_px > 1:
		dist = cv2.distanceTransform((mask > 0).astype(np.uint8), cv2.DIST_L2, 3)
		dist = np.clip(dist / max(1.0, float(feather_px)), 0.0, 1.0)
		mask_f = np.maximum(mask_f, dist)

	mask_3 = cv2.merge([mask_f, mask_f, mask_f])
	blended = (base.astype(np.float32) * (1.0 - mask_3) + overlay.astype(np.float32) * mask_3).astype(np.uint8)
	return blended


def place_tile(canvas: np.ndarray, alpha: np.ndarray, tile: np.ndarray, x: int, y: int) -> None:
	h, w = tile.shape[:2]
	ch, cw = canvas.shape[:2]

	x1 = max(0, x)
	y1 = max(0, y)
	x2 = min(cw, x + w)
	y2 = min(ch, y + h)

	if x1 >= x2 or y1 >= y2:
		return

	tx1 = x1 - x
	ty1 = y1 - y
	tx2 = tx1 + (x2 - x1)
	ty2 = ty1 + (y2 - y1)

	region = canvas[y1:y2, x1:x2]
	alpha_region = alpha[y1:y2, x1:x2]
	tile_region = tile[ty1:ty2, tx1:tx2]

	blended = (region.astype(np.float32) * (1.0 - alpha_region[..., None]) + tile_region.astype(np.float32) * alpha_region[..., None]).astype(np.uint8)
	canvas[y1:y2, x1:x2] = blended
	alpha[y1:y2, x1:x2] = np.maximum(alpha_region, 1.0)


def compute_canvas(tiles: List[SatelliteTile], tile_size: int, scale: float) -> Tuple[np.ndarray, np.ndarray, Tuple[float, float, float, float]]:
	lats = np.array([t.lat for t in tiles], dtype=np.float32)
	lons = np.array([t.lon for t in tiles], dtype=np.float32)

	lat_min, lat_max = float(lats.min()), float(lats.max())
	lon_min, lon_max = float(lons.min()), float(lons.max())

	margin = tile_size
	width = int(max(tile_size * 2, (lon_max - lon_min) * scale + margin * 2 + tile_size))
	height = int(max(tile_size * 2, (lat_max - lat_min) * scale + margin * 2 + tile_size))

	canvas = np.zeros((height, width, 3), dtype=np.uint8)
	alpha = np.zeros((height, width), dtype=np.float32)
	return canvas, alpha, (lat_min, lat_max, lon_min, lon_max)


def add_grid_overlay(image: np.ndarray, lat_min: float, lat_max: float, lon_min: float, lon_max: float, scale: float, show_grid: bool, show_coords: bool, show_timestamp: bool, timestamp_text: str) -> np.ndarray:
	out = image.copy()
	h, w = out.shape[:2]

	if show_grid:
		step = max(80, int(scale / 2))
		for x in range(0, w, step):
			cv2.line(out, (x, 0), (x, h), (255, 255, 255), 1, cv2.LINE_AA)
		for y in range(0, h, step):
			cv2.line(out, (0, y), (w, y), (255, 255, 255), 1, cv2.LINE_AA)

		for x in range(0, w, step):
			cv2.putText(out, f"lon {lon_min + x / max(1e-6, scale):.2f}", (x + 4, 18), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255, 255, 0), 1, cv2.LINE_AA)
		for y in range(0, h, step):
			cv2.putText(out, f"lat {lat_max - y / max(1e-6, scale):.2f}", (4, min(h - 4, y + 14)), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255, 255, 0), 1, cv2.LINE_AA)

	if show_coords:
		cv2.putText(out, f"Lat {lat_min:.3f} .. {lat_max:.3f}", (20, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2, cv2.LINE_AA)
		cv2.putText(out, f"Lon {lon_min:.3f} .. {lon_max:.3f}", (20, 58), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2, cv2.LINE_AA)

	if show_timestamp:
		cv2.putText(out, timestamp_text, (20, 88), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2, cv2.LINE_AA)

	return out


def temporal_difference(a: np.ndarray, b: np.ndarray) -> np.ndarray:
	target_w = min(a.shape[1], b.shape[1])
	target_h = min(a.shape[0], b.shape[0])
	a_r = cv2.resize(a, (target_w, target_h), interpolation=cv2.INTER_AREA)
	b_r = cv2.resize(b, (target_w, target_h), interpolation=cv2.INTER_AREA)
	diff = cv2.absdiff(a_r, b_r)
	gray = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)
	heat = cv2.applyColorMap(gray, cv2.COLORMAP_JET)
	return heat


def build_temporal_panel(before: np.ndarray, after: np.ndarray, diff: np.ndarray) -> np.ndarray:
	h = max(before.shape[0], after.shape[0], diff.shape[0])
	before_r = cv2.resize(before, (int(before.shape[1] * h / before.shape[0]), h), interpolation=cv2.INTER_AREA)
	after_r = cv2.resize(after, (int(after.shape[1] * h / after.shape[0]), h), interpolation=cv2.INTER_AREA)
	diff_r = cv2.resize(diff, (int(diff.shape[1] * h / diff.shape[0]), h), interpolation=cv2.INTER_AREA)
	return np.hstack([before_r, after_r, diff_r])


def compose_canvas(tiles: List[SatelliteTile], params: dict, show_grid: bool, show_coords: bool, show_timestamp: bool) -> Tuple[np.ndarray, Tuple[float, float, float, float], str]:
	ordered = sorted(tiles, key=lambda t: (t.timestamp, t.lat, t.lon))
	canvas, alpha, bounds = compute_canvas(ordered, params["tile_size"], params["scale"])
	lat_min, lat_max, lon_min, lon_max = bounds

	reference_mean = None
	if ordered:
		reference_mean = np.mean([tile.image.reshape(-1, 3).mean(axis=0) for tile in ordered], axis=0)

	timestamp_text = f"Timestamp: {ordered[-1].timestamp.strftime('%Y-%m-%d %H:%M:%S')}" if ordered else "Timestamp: -"

	for tile in ordered:
		compensated = exposure_compensation(tile.image, reference_mean, params["exposure_strength"])
		cloud = cloud_mask(compensated, params["white_threshold"], params["saturation_threshold"])
		valid_mask = cv2.bitwise_not(cloud)

		x = int((tile.lon - lon_min) * params["scale"] + params["tile_size"])
		y = int((lat_max - tile.lat) * params["scale"] + params["tile_size"])

		x1 = max(0, x)
		y1 = max(0, y)
		x2 = min(canvas.shape[1], x + compensated.shape[1])
		y2 = min(canvas.shape[0], y + compensated.shape[0])
		if x1 >= x2 or y1 >= y2:
			continue

		tx1 = x1 - x
		ty1 = y1 - y
		tx2 = tx1 + (x2 - x1)
		ty2 = ty1 + (y2 - y1)

		tile_region = compensated[ty1:ty2, tx1:tx2]
		mask_region = valid_mask[ty1:ty2, tx1:tx2]
		if np.count_nonzero(mask_region) == 0:
			continue

		alpha_mask = (mask_region.astype(np.float32) / 255.0)
		alpha_mask = cv2.GaussianBlur(alpha_mask, (0, 0), params["feather"] / 9.0)
		alpha_mask = np.clip(alpha_mask, 0.0, 1.0)

		base_region = canvas[y1:y2, x1:x2]
		existing = alpha[y1:y2, x1:x2]
		blend_w = alpha_mask * (1.0 - 0.35 * existing)
		blend_w3 = cv2.merge([blend_w, blend_w, blend_w])
		canvas[y1:y2, x1:x2] = (
			base_region.astype(np.float32) * (1.0 - blend_w3)
			+ tile_region.astype(np.float32) * blend_w3
		).astype(np.uint8)
		alpha[y1:y2, x1:x2] = np.maximum(existing, blend_w)

	display = add_grid_overlay(
		canvas,
		lat_min,
		lat_max,
		lon_min,
		lon_max,
		params["scale"],
		show_grid,
		show_coords,
		show_timestamp,
		timestamp_text,
	)
	return display, bounds, timestamp_text


