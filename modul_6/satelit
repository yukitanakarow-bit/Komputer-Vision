	def browse_folder(self):
		folder = filedialog.askdirectory(title="Pilih folder tile satelit")
		if folder:
			self.folder_var.set(folder)

	def open_output_folder(self):
		try:
			subprocess.Popen(["explorer", str(self.output_dir.resolve())])
		except Exception:
			pass

	def _runtime_params(self):
		try:
			tile_count = max(1, int(self.tile_count_var.get().strip()))
			tile_size = max(64, int(self.tile_size_var.get().strip()))
			scale = max(200.0, float(self.scale_var.get().strip()))
			exposure_strength = min(1.0, max(0.0, float(self.exposure_strength_var.get().strip())))
			white_threshold = int(self.white_threshold_var.get().strip())
			saturation_threshold = int(self.saturation_threshold_var.get().strip())
			feather = max(1, int(self.feather_var.get().strip()))
			bbox_lat_min = float(self.bbox_lat_min_var.get().strip())
			bbox_lat_max = float(self.bbox_lat_max_var.get().strip())
			bbox_lon_min = float(self.bbox_lon_min_var.get().strip())
			bbox_lon_max = float(self.bbox_lon_max_var.get().strip())
			zoom = max(1, min(19, int(self.zoom_var.get().strip())))
		except ValueError:
			return None

		return {
			"tile_count": tile_count,
			"tile_size": tile_size,
			"scale": scale,
			"exposure_strength": exposure_strength,
			"white_threshold": white_threshold,
			"saturation_threshold": saturation_threshold,
			"feather": feather,
			"bbox_lat_min": bbox_lat_min,
			"bbox_lat_max": bbox_lat_max,
			"bbox_lon_min": bbox_lon_min,
			"bbox_lon_max": bbox_lon_max,
			"zoom": zoom,
		}

	def load_tiles(self):
		params = self._runtime_params()
		if params is None:
			messagebox.showerror("Input Error", "Parameter numerik tidak valid.")
			return

		mode = self.source_mode_var.get().strip().lower()
		if mode == "folder":
			folder_text = self.folder_var.get().strip()
			if not folder_text:
				messagebox.showerror("Input Error", "Pilih folder tile dulu atau gunakan mode synthetic.")
				return
			folder = Path(folder_text)
			if not folder.exists():
				messagebox.showerror("Input Error", f"Folder tidak ditemukan: {folder}")
				return
			tiles = load_tiles_from_folder(folder, params["tile_size"])
			if not tiles:
				messagebox.showwarning("No Tiles", "Tidak ada gambar valid di folder. Menggunakan synthetic tiles.")
				tiles = generate_synthetic_tiles(params["tile_count"], params["tile_size"])
		elif mode == "download":
			lat_min = min(params["bbox_lat_min"], params["bbox_lat_max"])
			lat_max = max(params["bbox_lat_min"], params["bbox_lat_max"])
			lon_min = min(params["bbox_lon_min"], params["bbox_lon_max"])
			lon_max = max(params["bbox_lon_min"], params["bbox_lon_max"])
			tiles = download_osm_tiles(lat_min, lat_max, lon_min, lon_max, params["zoom"], params["tile_size"])
			if not tiles:
				messagebox.showwarning("Download", "Download tile gagal/kosong. Menggunakan synthetic tiles.")
				tiles = generate_synthetic_tiles(params["tile_count"], params["tile_size"])
		else:
			tiles = generate_synthetic_tiles(params["tile_count"], params["tile_size"])

		self.tiles = tiles
		self.status_var.set(f"Status: loaded {len(self.tiles)} tiles")
		self.metrics_var.set(f"Tiles: {len(self.tiles)} | Canvas: pending | Mode: {mode}")
		self.compose_tiles()

	def compose_tiles(self):
		if not self.tiles:
			self.load_tiles()
			if not self.tiles:
				return

		params = self._runtime_params()
		if params is None:
			messagebox.showerror("Input Error", "Parameter numerik tidak valid.")
			return

		tiles = sorted(self.tiles, key=lambda t: (t.timestamp, t.lat, t.lon))
		display, _bounds, _timestamp_text = compose_canvas(
			tiles,
			params,
			self.show_grid_var.get(),
			self.show_coords_var.get(),
			self.show_timestamp_var.get(),
		)

		self.composite = display
		self.last_display = display
		self.composite_path = self.output_dir / f"satellite_composite_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
		self._tk_img = bgr_to_photoimage(cv2.resize(display, (min(1300, display.shape[1]), min(720, display.shape[0])), interpolation=cv2.INTER_AREA))
		self.preview.configure(image=self._tk_img)
		source_set = sorted({t.source for t in tiles}) if tiles else ["-"]
		self.metrics_var.set(f"Tiles: {len(tiles)} | Canvas: {display.shape[1]}x{display.shape[0]} | Mode: {self.source_mode_var.get()} | Src: {'+'.join(source_set)}")
		self.temporal_info_var.set("Temporal: siap dibandingkan")
		self.status_var.set("Status: composite updated")

	def save_composite(self):
		if self.composite is None:
			self.compose_tiles()
			if self.composite is None:
				return

		if self.composite_path is None:
			self.composite_path = self.output_dir / f"satellite_composite_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
		cv2.imwrite(str(self.composite_path), self.composite)
		self.status_var.set(f"Status: saved {self.composite_path.name}")
		if self.auto_open_var.get():
			self.open_output_folder()

	def start_live(self):
		if self.running:
			return
		self.running = True
		self.start_btn.config(state=tk.DISABLED)
		self.stop_btn.config(state=tk.NORMAL)
		self.status_var.set("Status: live processing")
		self.live_update()

	def stop_live(self):
		self.running = False
		self.start_btn.config(state=tk.NORMAL)
		self.stop_btn.config(state=tk.DISABLED)
		if self.video_writer is not None:
			self.video_writer.release()
			self.video_writer = None
		self.status_var.set("Status: live stopped")

	def live_update(self):
		if not self.running:
			return
		self.compose_tiles()

		if self.record_var.get() and self.composite is not None:
			if self.video_writer is None:
				video_path = self.output_dir / f"satellite_record_{datetime.now().strftime('%Y%m%d_%H%M%S')}.mp4"
				self.video_writer = cv2.VideoWriter(
					str(video_path),
					cv2.VideoWriter_fourcc(*"mp4v"),
					20,
					(self.composite.shape[1], self.composite.shape[0]),
				)
				self.status_var.set(f"Status: recording -> {video_path.name}")
				if self.auto_open_var.get():
					self.open_output_folder()
			self.video_writer.write(self.composite)

		self.root.after(500, self.live_update)

	def build_temporal_comparison(self):
		if len(self.tiles) < 2:
			messagebox.showinfo("Temporal", "Butuh minimal 2 tile untuk temporal comparison.")
			return

		params = self._runtime_params()
		if params is None:
			messagebox.showerror("Input Error", "Parameter numerik tidak valid.")
			return

		sorted_tiles = sorted(self.tiles, key=lambda t: t.timestamp)
		mid = max(1, len(sorted_tiles) // 2)
		before_tiles = sorted_tiles[:mid]
		after_tiles = sorted_tiles[mid:]
		if not after_tiles:
			after_tiles = [sorted_tiles[-1]]

		before, _bounds_before, _ts_before = compose_canvas(before_tiles, params, False, False, False)
		after, _bounds_after, _ts_after = compose_canvas(after_tiles, params, False, False, False)
		diff = temporal_difference(before, after)
		panel = build_temporal_panel(before, after, diff)
		self.last_temporal_panel = panel
		self._tk_img = bgr_to_photoimage(cv2.resize(panel, (min(1300, panel.shape[1]), min(720, panel.shape[0])), interpolation=cv2.INTER_AREA))
		self.preview.configure(image=self._tk_img)
		self.temporal_info_var.set(
			f"Temporal: before {before_tiles[0].timestamp.strftime('%Y-%m-%d %H:%M:%S')}..{before_tiles[-1].timestamp.strftime('%H:%M:%S')} | after {after_tiles[0].timestamp.strftime('%Y-%m-%d %H:%M:%S')}..{after_tiles[-1].timestamp.strftime('%H:%M:%S')}"
		)
		self.status_var.set("Status: temporal comparison generated")

	def use_first_last_temporal(self):
		self.build_temporal_comparison()

	def reset_all(self):
		self.tiles = []
		self.composite = None
		self.last_display = None
		self.last_temporal_panel = None
		self._tk_img = None
		self.preview.configure(image="")
		self.metrics_var.set("Tiles: 0 | Canvas: - | Mode: -")
		self.temporal_info_var.set("Temporal: belum dipilih")
		self.status_var.set("Status: reset")

	def on_close(self):
		self.stop_live()
		self.root.destroy()

	def run(self):
		self.root.mainloop()


def main():
	app = SatelliteCompositorApp()
	app.run()


if __name__ == "__main__":
	main()
